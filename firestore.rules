rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 🔥 SECURE PRODUCTION RULES: Only authenticated users can read & write data
    match /soil_test_bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
